{"nodes": [{"id": "docs_runbooks_migrating_to_production_doc", "label": "Migrating to Production Runbook", "file_type": "document", "source_file": "docs/runbooks/migrating-to-production.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_runbooks_migrating_to_production_db_before_app", "label": "DB before app golden rule", "file_type": "rationale", "source_file": "docs/runbooks/migrating-to-production.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every migration is additive and RPC parameters always default, so migrating the DB first and deploying the app after keeps the currently deployed build working against the new schema."}, {"id": "docs_runbooks_migrating_to_production_migrate_script", "label": "scripts/migrate.mjs", "file_type": "code", "source_file": "docs/runbooks/migrating-to-production.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_runbooks_migrating_to_production_enum_transaction_rule", "label": "alter type add value must be alone in its file", "file_type": "rationale", "source_file": "docs/runbooks/migrating-to-production.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The runner wraps each migration in begin...commit, and Postgres refuses to use an enum value added in the same transaction (55P04)."}, {"id": "docs_runbooks_migrating_to_production_drop_before_create", "label": "drop function before create on signature change", "file_type": "rationale", "source_file": "docs/runbooks/migrating-to-production.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without the drop, a changed return type or argument list creates a second overload and calls fail with 42725 not unique."}], "edges": [{"sourc